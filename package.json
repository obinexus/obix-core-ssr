{
  "name": "obix-core-ssr",
  "version": "0.5.0",
  "description": "OBIX SSR projection — DOM-free renderToString. Structurally cannot import the DOM driver (obix-driver-dom) or the reactive projection (obix-core-reactive). Depends on obix-core-spec only.",
  "license": "MIT",
  "author": "OBINexus Computing — Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "test",
    "CHANGELOG.md",
    "PROVENANCE.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "obix-core-spec": "0.5.0"
  },
  "devDependencies": {
    "obix-fixture-timer": "0.5.0"
  },
  "keywords": [
    "obix"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/obix-core-ssr.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/obix-core-ssr/issues"
  },
  "homepage": "https://github.com/obinexus/obix-core-ssr#readme"
}
